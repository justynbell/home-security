				)
				(text "2.2k PU"
					(at -3.81 -2.54 0)
					(effects
						(font
							(size 0.508 0.508)
							(color 142 142 142 1)
						)
						(justify right)
					)
				)
				(text "10k PU"
					(at -3.81 -10.16 0)
					(effects
						(font
							(size 0.508 0.508)
							(color 142 142 142 1)
						)
						(justify right)
					)
				)
				(text "GPIO0 free in ESP32-POE variants with WROOM module\nGPIO0, GPIO0 are boot mode bootstrap pins\nGPIO2, GPIO14, GPIO15 are multiplexed with SD card, if no SD card is present, they're free\nGPIO1, GPIO3 are used for USB programming, they can be free if USB programming is not used\nGPI39 is connected to measure external power supply voltage, can be freed via jumper\nGPI34 is connected to the user button BUT1 and has 10k pullup, can be configured for manual boot\nGPI35 is free to use by default, can be connected to measure the LiPo battery if you close BAT_SENS_E1 jumper"
					(at 0 -19.05 0)
					(effects
						(font
							(size 1.016 1.016)
						)
						(justify top)
					)
				)
				(text "+5V:\n1. Can be input and output; if you use it as input make sure no other 5V sources are applied to the board (having Li-Po battery is okay)\n2. When the board is attached to USB or Ethernet POE this line can be used ONLY as output to power attached peripherals\n3. When you use the 5V line as output to power external devices it can provide up to 0.8A @ 5V (4W) max. This includes the 3.3V power output\nThe combined power draw of +5V output and +3.3V output must not exceed 4W"
					(at 0 -35.56 0)
					(effects
						(font
							(size 1.016 1.016)
						)
					)
				)
				(text "+3.3V\nOutput only which can source up to 0.5A @ 3.3V (1.65W)"
					(at 0 -41.91 0)
					(effects
						(font
							(size 1.016 1.016)
						)
					)
				)
				(text "2.2k PU"
					(at 3.81 12.7 0)
					(effects
